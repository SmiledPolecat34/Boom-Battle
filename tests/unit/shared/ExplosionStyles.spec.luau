	it("les effets pas encore réalisés reprennent la recette classique teintée de leur couleur", function()
		for _, id in CosmeticConfig.idsOfKind("effect") do
			local item = CosmeticConfig.get(id)
			local style = ExplosionStyles.get(id, item.color)
			checkStyle(style)
			if id ~= "effect_classic" and id ~= "effect_red" and id ~= "effect_blue" and id ~= "effect_green" and id ~= "effect_yellow" and id ~= "effect_ice" and id ~= "effect_electric" and id ~= "effect_fire" and id ~= "effect_rainbow" and id ~= "effect_neon" and id ~= "effect_meteor" and id ~= "effect_crystal" and id ~= "effect_heart" and id ~= "effect_stars" and id ~= "effect_smoke" and id ~= "effect_aura" and id ~= "effect_water" and id ~= "effect_nature" and id ~= "effect_sand" and id ~= "effect_toxic" and id ~= "effect_cosmic" then
