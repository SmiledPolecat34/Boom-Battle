--!nocheck
-- ExplosionStyles : styles visuels d'explosion (palette + recette) ; données pures, cosmétiques.
local ExplosionStyles = world.module("ExplosionStyles")
local CosmeticConfig = world.module("CosmeticConfig")

local KINDS = { "center", "junction", "segment", "end", "impact" }

local function checkStyle(style)
	expect(type(style.id)).toBe("string")
	for _, key in { "core", "mid", "edge", "smoke", "debris" } do
		expect(typeof(style.palette[key])).toBe("Color3")
	end
	for _, group in { "spikes", "smoke", "debris", "sparks" } do
		for _, kind in KINDS do
			local count = style.recipe[group][kind]
			expect(type(count)).toBe("number")
			expect(count).toBeGreaterThanOrEqual(0)
			expect(count).toBeLessThanOrEqual(14) -- budget : aucun module ne dépasse 14 éléments d'un type
		end
	end
	expect(type(style.recipe.ring)).toBe("boolean")
end

